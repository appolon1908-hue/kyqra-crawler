server {
    listen 10.40.0.4:18444 ssl;
    server_name kyqra.internal.codestra.agency;
    server_tokens off;

    ssl_certificate /etc/codestra/mtls/kyqra/server-fullchain.crt;
    ssl_certificate_key /etc/codestra/mtls/kyqra/server.key;
    ssl_client_certificate /etc/codestra/mtls/kyqra/client-ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 2;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    if ($ssl_client_s_dn !~ "^CN=middleware-kyqra-client$") { return 403; }
    if ($ssl_client_serial != "__KYQRA_CLIENT_SERIAL__") { return 403; }

    client_max_body_size 2m;
    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Codestra-mTLS-Client $ssl_client_s_dn;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_pass http://127.0.0.1:3100;
    }
}
