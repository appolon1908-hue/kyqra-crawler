{
  "name": "kyqra-crawler",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint src/**/*.ts test/**/*.mjs eslint.config.js",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "test:security": "node --test test/security.test.mjs",
    "test:policy": "node --test test/policy.test.mjs test/release-signing-policy.test.mjs",
    "test:release-signing": "node --test test/release-signing-policy.test.mjs && ./scripts/validate-release-signing-policy.sh"
  },
  "dependencies": {
    "@crawlee/cheerio": "3.18.1",
    "@crawlee/core": "3.18.1",
    "@crawlee/playwright": "3.18.1",
    "bullmq": "5.81.3",
    "fastify": "5.12.1",
    "ioredis": "5.7.0",
    "pg": "8.16.3",
    "playwright": "1.62.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
